# Google Gemini / Antigravity API Credentials
# Lấy API key tại: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Môi trường chạy
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cấu hình Human-in-the-Loop (true: hỏi ý kiến con người tại các gate; false: tự động bypass cho CI/CD)
HITL_ENABLED=true
