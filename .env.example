# Google Gemini / Antigravity API Credentials
# Lấy API key tại: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here

# Môi trường chạy
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cấu hình Human-in-the-Loop (true: hỏi ý kiến con người tại các gate; false: tự động bypass cho CI/CD)
HITL_ENABLED=true

# ==============================================================================
# CẤU HÌNH PHÂN BỔ MÔ HÌNH AI & TỐI ƯU CHI PHÍ (MODEL ALLOCATION MATRIX)
# ==============================================================================
# Lựa chọn 1: Mặc định Gemini 2.5 Series (Khuyên dùng ổn định):
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_FLASH_LITE_MODEL=gemini-2.5-flash-lite

# Lựa chọn 2: Sẵn sàng kích hoạt Gemini 3.8 Series trên Antigravity 2.0 (bỏ comment để bật):
# GEMINI_PRO_MODEL=gemini-3.8-pro
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_FLASH_LITE_MODEL=gemini-3.8-flash-lite
